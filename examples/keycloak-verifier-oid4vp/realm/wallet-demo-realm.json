{
  "realm": "wallet-demo",
  "enabled": true,
  "sslRequired": "NONE",
  "clients": [
    {
      "clientId": "wallet-mock",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "oid4vp",
      "displayName": "Sign in with Wallet",
      "providerId": "oid4vp",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "not-used",
        "clientSecret": "not-used",
        "sameDeviceEnabled": "true",
        "crossDeviceEnabled": "false",
        "walletScheme": "openid4vp://",
        "responseMode": "direct_post",
        "clientIdScheme": "plain",
        "x509CertificatePem": "",
        "x509SigningKeyJwk": "",
        "principalAttributes": "sdjwt_urn_eudi_pid_1:personal_administrative_number",
        "trustMaterialIdps": "demo-trust-list"
      }
    },
    {
      "alias": "demo-trust-list",
      "displayName": "Demo Trust List",
      "providerId": "etsi-trust-list",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "config": {
        "trustListUrl": "http://host.docker.internal:8085/api/trustlist",
        "trustListLoTEType": "http://uri.etsi.org/19602/LoTEType/EUPIDProvidersList"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "sd-jwt-family_name",
      "identityProviderAlias": "oid4vp",
      "identityProviderMapper": "oid4vp-sd-jwt-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "credential.type": "urn:eudi:pid:1",
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "sd-jwt-given_name",
      "identityProviderAlias": "oid4vp",
      "identityProviderMapper": "oid4vp-sd-jwt-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "credential.type": "urn:eudi:pid:1",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "sd-jwt-birthdate",
      "identityProviderAlias": "oid4vp",
      "identityProviderMapper": "oid4vp-sd-jwt-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "credential.type": "urn:eudi:pid:1",
        "claim": "birthdate",
        "user.attribute": "birthdate"
      }
    }
  ]
}
