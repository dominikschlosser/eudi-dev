# rate_limit is a plugin (see Dockerfile), so its place in the handler order
# has to be stated. Before basic_auth, so a flood of /stats guesses is capped
# too.
{
	order rate_limit before basic_auth
}

eudi-test.dev {
	# Usage statistics: a GoAccess report built from the access log below,
	# served behind basic auth. Credentials come from stats.env
	# (see deploy.sh stats-password). Remove this block to turn stats off.
	handle_path /stats* {
		basic_auth {
			# Defaults to a hash of a random password nobody knows, so /stats
			# is locked until stats.env supplies real credentials.
			{$STATS_USER:admin} {$STATS_PASSWORD_HASH:$2a$14$V7D3pFZve2L.q3gUq4eClO5tFhhLhsqt/ArHoetKkFFshQT84QE5i}
		}
		root * /srv/stats
		file_server {
			index report.html
		}
	}

	handle {
		reverse_proxy wallet:8085
	}

	# Access log for the usage report. ip_mask anonymizes at write time:
	# the last IPv4 octet and the last 80 bits of an IPv6 address are
	# zeroed, so no full address is ever stored, while GoAccess can still
	# approximate distinct visitors.
	log {
		# Bounded on disk: at most roll_size x (roll_keep + 1), so ~40 MiB,
		# and nothing older than a month. The report below only reads the
		# current file, so a roll also caps how far back stats reach.
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}

	# Rate limiting per client address (caddy-ratelimit, built into the image
	# by the Dockerfile). A request is counted in every zone that matches it,
	# and exceeding a zone answers 429 with Retry-After.
	#
	# These are ceilings against abuse, not traffic shaping. They sit far above
	# what the demo produces today (an idle page is about 14 requests, since
	# updates arrive over one long-lived event stream, and a busy visitor with
	# three tabs open, issuing and presenting, produced 36 in a minute), so
	# there is room for a browser, a test suite driving the HTTP API, and
	# everyone behind one office or conference address at once.
	rate_limit {
		# Endpoints that cost the demo something: they either make the wallet
		# fetch a URL somebody handed it (a request object, issuer metadata, a
		# credential, a status list, each holding an outbound connection for up
		# to 15 seconds) or grow state that only the next reset clears
		# (credentials in wallet.json, activity log entries, status list
		# indices).
		#
		# Two windows on the same set: the minute allows a burst, such as a
		# test suite working through a scenario, and the hour bounds what a
		# loop left running can accumulate before the daily reset.
		zone flows_burst {
			match {
				method POST
				path /api/presentations /api/dc-api /api/offers /api/issue /api/generate-pid /api/credentials /api/credentials/*/refresh /api/deferred/*/collect /issuer/api/offers /verifier/api/requests
			}
			key {remote_host}
			events 120
			window 1m
		}
		zone flows_hour {
			match {
				method POST
				path /api/presentations /api/dc-api /api/offers /api/issue /api/generate-pid /api/credentials /api/credentials/*/refresh /api/deferred/*/collect /issuer/api/offers /verifier/api/requests
			}
			key {remote_host}
			events 2000
			window 1h
		}
		# Everything else, including the UI and the stats report.
		zone site {
			key {remote_host}
			events 1200
			window 1m
		}
	}
}
